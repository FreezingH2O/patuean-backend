# Copy to .env and adjust. All have working defaults for local dev.

# SQLite single-file DB for the PoC. Swap for a Postgres URL to promote later.
DATABASE_URL=sqlite:///./voiceguard.db

# JWT signing secret — MUST be changed for anything non-local.
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Frontend origins allowed by CORS (comma-separated). Must include the Vite dev origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- External detection APIs (the 3 real models) ----
# Leave a URL blank to fall back to that model's deterministic stub.
# Uploaded audio is transcoded to 16kHz mono WAV before being sent to anti-spoof/ASR.

# Anti-spoof (AWS API Gateway) — raw audio body, x-api-key header.
# Response: {"prediction","score","is_bona_fide"}; score>0 = real, <0 = fake.
ANTISPOOF_API_URL=https://7ur8kuu0bd.execute-api.us-east-1.amazonaws.com/prod/analyze
ANTISPOOF_API_KEY=

# Typhoon ASR (OpenAI-compatible /audio/transcriptions), Bearer auth.
ASR_API_URL=https://api.opentyphoon.ai/v1/audio/transcriptions
ASR_API_KEY=
ASR_MODEL=typhoon-asr-realtime

# Thai LLM (OpenAI-compatible /chat/completions), Bearer auth.
LLM_API_URL=http://thaillm.or.th/api/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=typhoon-s-thaillm-8b-instruct

# Anon (logged-out) live-test allowance before 429.
ANON_LIVE_TEST_LIMIT=5
